{
  "name": "stake-mirrors-ping-gui",
  "version": "2.1.0",
  "description": "Desktop GUI for Stake Mirrors Ping",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --config electron-builder.cjs",
    "build:mac": "electron-builder --config electron-builder.cjs --mac",
    "build:win": "electron-builder --config electron-builder.cjs --win",
    "build:linux": "electron-builder --config electron-builder.cjs --linux",
    "test": "node --test tests/*.test.js",
    "build:check": "electron-builder --config electron-builder.cjs --dir",
    "test:electron": "node e2e/gui.cjs",
    "test:electron:packaged": "node e2e/gui.cjs --packaged",
    "test:desktop": "node e2e/desktop.cjs"
  },
  "keywords": [],
  "author": {
    "name": "blackterminal",
    "email": "subkoks@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.stakemirrors.ping",
    "productName": "Stake Mirrors Ping",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "bridge.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json",
      "ipc-policy.js",
      "python-runtime.js",
      "backend-runtime.js",
      "desktop-services.js"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "minimumSystemVersion": "13.0"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "../config.yaml",
        "to": "config.yaml"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "homepage": "https://github.com/subkoks/stake-mirrors-ping",
  "repository": {
    "type": "git",
    "url": "https://github.com/subkoks/stake-mirrors-ping"
  }
}
