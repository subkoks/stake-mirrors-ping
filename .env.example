# Stake.com session token (from browser cookies)
# How to get: Open browser dev tools (F12) → Application → Cookies → copy "session" value
STAKE_SESSION_TOKEN=your_session_token_here

# SECURITY: comma-separated domains allowed to receive the session token during
# --api tests. The token is withheld from every domain not listed here (and not
# in config.yaml settings.trusted_api_domains). Leave empty to disable
# authenticated API tests entirely. Add ONLY domains you have personally verified.
# STAKE_TRUSTED_DOMAINS=stake.com
